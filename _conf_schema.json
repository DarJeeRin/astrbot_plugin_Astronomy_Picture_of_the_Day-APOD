{
    "token": {
        "description": "旧版 NASA API Token（已停用）",
        "hint": "仅为兼容旧配置保留；迁移后的 NASA APOD 公共接口无需 Token，此字段不再使用",
        "type": "string"
    },
    "image": {
        "description": "是否发送图片",
        "hint": "NASA每日一图的标志性内容，建议开启",
        "type": "bool",
        "default": true
    },
    "explanation": {
        "description": "图片说明",
        "type": "object",
        "items": {
            "is_show": {
                "hint": "官方说明通常比较长，包含丰富的科学信息",
                "description": "是否发送NASA官方的图片说明",
                "type": "bool",
                "default": true
            },
            "is_translate": {
                "hint": "原文一般是英文",
                "description": "是否翻译说明为简体中文",
                "type": "bool",
                "default": true
            }
        }
    },
    "title": {
        "description": "标题配置",
        "type": "object",
        "items": {
            "is_show": {
                "description": "是否发送标题",
                "type": "bool",
                "default": true
            },
            "is_translate": {
                "description": "是否翻译标题",
                "type": "bool",
                "default": true
            }
        }
    },
    "provider": {
        "hint": "如果启用了翻译功能但未配置提供商，将无法进行翻译并可能导致错误日志",
        "description": "翻译所使用的LLM提供商",
        "_special": "select_provider",
        "type": "string"
    },
    "date": {
        "description": "日期配置",
        "type": "object",
        "items": {
            "is_show": {
                "description": "是否发送日期",
                "type": "bool",
                "default": true
            }
        }
    },
    "is_divided": {
        "description": "是否分开发送图片和文本内容",
        "type": "bool",
        "default": true
    },
    "timeout": {
        "description": "请求 APOD 数据的超时时间，单位为秒",
        "type": "int",
        "default": 120
    },
    "retry_count": {
        "description": "遇到 NASA API 临时错误时的重试次数",
        "type": "int",
        "default": 2
    },
    "push": {
        "description": "自动推送配置",
        "type": "object",
        "items": {
            "enabled": {
                "description": "是否启用自动推送",
                "type": "bool",
                "default": true
            },
            "target_unified_msg_origins": {
                "description": "自动推送目标会话 UMO 列表",
                "hint": "可通过 /sid 获取 UMO；支持数组，或使用逗号/换行分隔的字符串",
                "type": "list",
                "default": []
            },
            "daily_push_time": {
                "description": "每天自动推送时间（本机时区，24小时制 HH:MM）",
                "hint": "示例：09:00、20:30；若格式不合法会回退到 09:00",
                "type": "string",
                "default": "09:00"
            },
            "max_groups_per_round": {
                "description": "单轮最多推送的会话数量，0 表示不限制",
                "type": "int",
                "default": 0
            }
        }
    },
    "video": {
        "description": "视频配置",
        "type": "object",
        "items": {
            "download": {
                "description": "是否下载并发送直链视频",
                "hint": "仅下载 MP4、WebM、MOV、M4V 等视频直链；YouTube、Vimeo 等页面外链始终返回缩略图和原始链接",
                "type": "bool",
                "default": false
            },
            "max_download_mb": {
                "description": "单个视频最大下载大小（MB）",
                "hint": "超过上限或下载失败时会自动回退为缩略图和视频链接",
                "type": "int",
                "default": 100
            },
            "download_timeout": {
                "description": "视频下载总超时（秒）",
                "hint": "独立于 NASA 数据请求 timeout；低带宽可适当增大，失败日志包含已下载字节和耗时",
                "type": "int",
                "default": 120
            }
        }
    }
}
